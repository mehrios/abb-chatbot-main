# API Keys
GEMINI_API_KEY=GEMINI_API_KEY
OPENAI_API_KEY=OPENAI_API_KEY

# Database
DATABASE_URL=sqlite:///./abb.db

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=ABB_Knowledge

# REDIS CACHE 
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# CACHE SETTINGS
SEMANTIC_CACHE_THRESHOLD=0.85
CACHE_TTL=3600

# Rate Limiting
LLM_RATE_LIMIT_SECONDS=20
RETRIEVER_RATE_LIMIT_SECONDS=10
MAX_REQUESTS_PER_MINUTE=20
MAX_REQUESTS_PER_HOUR=100

# Chat Settings
MAX_HISTORY_MESSAGES=5
HISTORY_FIRST_N=2
HISTORY_LAST_N=3

# Retriever
MIN_SIMILARITY_THRESHOLD=0.20
TOP_K_RESULTS=3

# Costs (per 1M tokens)
COST_PER_MILLION_TOKENS=15

SEMANTIC_CACHE_THRESHOLD=0.85